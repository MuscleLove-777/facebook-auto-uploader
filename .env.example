# Facebook Graph API
FB_PAGE_ID=あなたのFacebookページID（数字）
FB_PAGE_ACCESS_TOKEN=ページアクセストークン（長期・60日）

# Facebook App（トークン更新用）
FB_APP_ID=Meta DevelopersのアプリID
FB_APP_SECRET=アプリシークレット

# Google Drive（gdownでキーレス取得。GOOGLE_API_KEYは不要: 憲法第4条）
GDRIVE_FOLDER_ID_FACEBOOK=安全素材（画像/動画）を入れたGoogleDriveフォルダID

# LINE通知（オプション）
LINE_CHANNEL_TOKEN=LINEチャネルトークン
LINE_USER_ID=LINEユーザーID
